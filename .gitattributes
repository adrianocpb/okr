# Normaliza finais de linha no repositório (LF), evitando diferenças entre Windows e o CI.
* text=auto eol=lf

# Scripts do Windows mantêm CRLF
*.ps1 text eol=crlf
*.bat text eol=crlf

# Binários
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary

# Scripts do servidor (Linux) precisam de LF
*.sh text eol=lf
