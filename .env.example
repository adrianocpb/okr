# Copie este arquivo para `.env` (que NÃO é versionado) e ajuste os valores.
# Aqui há apenas nomes de variáveis e valores fictícios.

# Ambiente: config.settings.dev (local) | config.settings.prod (servidor)
DJANGO_SETTINGS_MODULE=config.settings.dev

# Chave secreta. Gere uma com:
#   .venv\Scripts\python -c "import secrets; print(secrets.token_urlsafe(64))"
DJANGO_SECRET_KEY=trocar-por-chave-gerada

# Modo de depuração (somente desenvolvimento)
DJANGO_DEBUG=true

# Hosts permitidos, separados por vírgula
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost

# Banco de dados. Caminho relativo do SQLite é resolvido a partir da raiz do projeto.
# Futuro (PostgreSQL): postgres://usuario:senha@servidor:5432/okr
DATABASE_URL=sqlite:///var/okr.sqlite3

# --- Backup (usado a partir da Etapa 2) ---
# Pasta FORA do repositório
# OKR_BACKUP_DIR=C:/caminho/para/backups
# OKR_BACKUP_RETENCAO=30
# OKR_BACKUP_CHAVE=trocar-por-chave-gerada
